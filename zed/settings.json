// Zed Settings — 2026, tuned for web + Kotlin, dark/pastel, high readability
{
  // ---------- Theme & icons ----------
  // Catppuccin Mocha = soft pastel, low eye-strain, best-in-class readability.
  // Swap themes live with Cmd+K Cmd+T. Great pastel alternatives: "Rosé Pine",
  // "Rosé Pine Moon", "Tokyo Night", "Kanagawa".
  "cli_default_open_behavior": "existing_window",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },

  // ---------- Fonts ----------
  // Primary: Geist Mono (modern, clean, designed for web work).
  // Fallbacks kick in automatically if a font isn't installed.
  // ".ZedMono" is the bundled font, so the chain always resolves.
  "buffer_font_family": "Geist Mono",
  "buffer_font_fallbacks": ["JetBrainsMono NF", ".ZedMono"],
  "ui_font_family": "Geist",
  "ui_font_fallbacks": [".SystemUIFont", ".ZedSans"],

  // Bigger + more readable than before
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_weight": 400,
  "buffer_font_features": { "calt": true, "liga": true },
  "buffer_line_height": { "custom": 1.7 },

  // ---------- Editor ----------
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "show_wrap_guides": true,
  "wrap_guides": [80, 100],
  "cursor_blink": false,
  "scroll_beyond_last_line": "one_page",
  "relative_line_numbers": "disabled",

  // Save behavior
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,

  // Line endings: prefer LF, honor .editorconfig end_of_line
  "line_ending": "prefer_lf",

  // ---------- Navigation ----------
  "go_to_definition_scroll_strategy": "preserve",

  // ---------- Code lens (inline run/test/reference actions) ----------
  "code_lens": "on",

  // ---------- Indent guides (rainbow) ----------
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },

  // ---------- Completions & hints ----------
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
  },

  // ---------- Edit predictions (AI) ----------
  "edit_predictions": {
    "mode": "eager",
    "enabled_in_text_threads": true,
  },
  "show_edit_predictions": true,

  // ---------- Git ----------
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": { "enabled": true, "delay_ms": 600 },
  },

  // ---------- AI Agent ----------
  // Model is switchable in-app — pick the newest in the model dropdown.
  "agent": {
    "enabled": true,
    "button": true,
    "dock": "right",
    "default_width": 640,
    "default_model": { "provider": "zed.dev", "model": "claude-sonnet-4" },
  },

  // ---------- Panels ----------
  "project_panel": {
    "button": true,
    "dock": "left",
    "git_status": true,
    "file_icons": true,
    "folder_icons": true,
    "auto_fold_dirs": true,
    "auto_reveal_entries": true,
    "indent_size": 20,
    "bold_folder_labels": true,
    "indent_guides": { "show": "always" },
  },
  "outline_panel": {
    "button": true,
    "dock": "right",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
  },

  // ---------- Tabs ----------
  "tab_bar": { "show": true, "show_nav_history_buttons": false },
  "tabs": { "file_icons": true, "git_status": true, "close_position": "right" },

  // ---------- Terminal ----------
  "terminal": {
    "font_family": "Geist Mono",
    "font_fallbacks": ["JetBrains Mono", ".ZedMono"],
    "font_size": 15,
    "line_height": "comfortable",
    "blinking": "off",
    "working_directory": "current_project_directory",
  },

  // ---------- Performance ----------
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/target",
    "**/build",
    "**/dist",
    "**/.next",
    "**/.cache",
    "**/coverage",
  ],

  // ---------- Language overrides ----------
  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },
    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "code_actions_on_format": { "source.fixAll.eslint": true },
    },
    "HTML": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "CSS": { "tab_size": 2, "format_on_save": "on", "colorize_brackets": true },
    "Kotlin": {
      "tab_size": 4,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "JSON": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "JSONC": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "Markdown": {
      "tab_size": 2,
      "soft_wrap": "editor_width",
      "format_on_save": "off",
    },
  },

  // ---------- LSP ----------
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "tailwindCSS": { "emmetCompletions": true },
        "classFunctions": ["cva", "cx", "clsx", "tw"],
      },
    },
  },

  // ---------- Telemetry ----------
  "telemetry": { "diagnostics": false, "metrics": false },

  // ---------- Vim (off) ----------
  "vim_mode": false,
}
