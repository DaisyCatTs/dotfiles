{
  "disable_ai": true,

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  "cli_default_open_behavior": "existing_window",
  "prettier": {
    "allowed": true,
  },

  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },

  "ui_font_family": "Geist",
  "ui_font_fallbacks": [".SystemUIFont", ".ZedSans"],
  "ui_font_size": 16,

  "buffer_font_family": "Geist Mono",
  "buffer_font_fallbacks": ["JetBrains Mono", ".ZedMono"],
  "buffer_font_size": 16,
  "buffer_line_height": {
    "custom": 1.55,
  },
  "buffer_font_features": {
    "calt": true,
    "liga": true,
  },

  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "show_whitespaces": "boundary",
  "colorize_brackets": true,
  "scroll_beyond_last_line": "one_page",

  "indent_guides": {
    "active_line_width": 2,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },

  "show_signature_help_after_edits": true,
  "hover_popover_hiding_delay": 800,

  "inlay_hints": {
    "enabled": true,
  },

  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
    },
  },

  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "format_on_save": "modifications_if_available",
  "line_ending": "prefer_lf",

  "tasks": {
    "prefer_lsp": true,
  },

  "git": {
    "inline_blame": {
      "delay_ms": 600,
    },
  },

  "tab_bar": {
    "show_nav_history_buttons": false,
  },

  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "right",
  },

  "project_panel": {
    "button": true,
    "dock": "left",
    "folder_indicator": "icon",
    "file_icons": true,
    "git_status": true,
    "bold_folder_labels": true,
    "indent_guides": {
      "show": "always",
    },
  },

  "outline_panel": {
    "button": true,
    "dock": "right",
    "folder_indicator": "icon",
    "file_icons": true,
    "git_status": true,
  },

  "terminal": {
    "font_family": "Geist Mono",
    "font_fallbacks": ["JetBrains Mono", ".ZedMono"],
    "font_size": 15,
    "line_height": "comfortable",
    "blinking": "off",
    "working_directory": "current_project_directory",
  },

  "file_scan_exclusions": [
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/.gradle",
    "**/.next",
    "**/.cache",
    "**/coverage",
    "**/.terraform",
    "...",
  ],

  "languages": {
    "Skript": {
      "tab_size": 4,
      "hard_tabs": true,
      "formatter": "language_server",
      "semantic_tokens": "combined",
      "document_symbols": "on",
      "document_folding_ranges": "on",
    },

    "Kotlin": {
      "tab_size": 4,
      "format_on_save": "modifications_if_available",
      "document_symbols": "on",
    },

    "Java": {
      "tab_size": 4,
      "document_symbols": "on",
    },

    "Gradle": {
      "tab_size": 4,
    },

    "Groovy": {
      "tab_size": 4,
    },

    "Astro": {
      "format_on_save": "modifications_if_available",
    },

    "TypeScript": {
      "document_symbols": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.addMissingImports.ts": true,
        "source.fixAll.eslint": true,
      },
    },

    "TSX": {
      "document_symbols": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.addMissingImports.ts": true,
        "source.fixAll.eslint": true,
      },
    },

    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },

    "YAML": {
      "document_symbols": "on",
    },

    "Lua": {
      "document_symbols": "on",
    },

    "Markdown": {
      "format_on_save": "off",
    },
  },

  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx", "clsx", "tw", "cn"],
        "tailwindCSS": {
          "emmetCompletions": true,
        },
      },
    },

    "skript-lsp": {
      "binary": {
        "path": "E:/Dev Projects/ZedSkript/language-server/target/release/skript-lsp.exe",
      },
    },

    "discord_presence": {
      "initialization_options": {
        "idle": {
          "timeout": 3600,
          "action": "change_activity",
        },
      },
    },
  },
}
