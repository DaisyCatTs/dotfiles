{
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "vim_mode": false,
  "cli_default_open_behavior": "existing_window",
  "prettier": {
    "allowed": true,
  },

  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },

  "ui_font_family": "Geist",
  "ui_font_fallbacks": [".SystemUIFont", ".ZedSans"],
  "ui_font_size": 16,

  "buffer_font_family": "Geist Mono",
  "buffer_font_fallbacks": ["JetBrains Mono", ".ZedMono"],
  "buffer_font_size": 16,
  "buffer_font_weight": 400,
  "buffer_font_features": {
    "calt": true,
    "liga": true,
  },
  "buffer_line_height": {
    "custom": 1.55,
  },

  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "show_wrap_guides": false,
  "centered_layout": {
    "left_padding": 0.2,
    "right_padding": 0.2,
  },
  "cursor_blink": true,
  "cursor_shape": "bar",
  "scroll_beyond_last_line": "one_page",
  "show_whitespaces": "boundary",
  "go_to_definition_scroll_strategy": "center",
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },

  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "format_on_save": "modifications_if_available",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "line_ending": "prefer_lf",

  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "show_signature_help_after_edits": true,
  "hover_popover_hiding_delay": 800,
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
    },
  },
  "tasks": {
    "prefer_lsp": true,
  },

  "gutter": {
    "min_line_number_digits": 4,
    "line_numbers": true,
    "runnables": true,
  },
  "git": {
    "git_gutter": "tracked_files",
    "enable_status": true,
    "enable_diff": true,
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
    },
  },

  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "right",
  },
  "agent": {
    "enabled": true,
    "button": true,
    "dock": "right",
    "default_width": 720,
    "notify_when_agent_waiting": "never",
  },
  "project_panel": {
    "button": true,
    "dock": "left",
    "folder_indicator": "icon",
    "file_icons": true,
    "git_status": true,
    "auto_fold_dirs": true,
    "auto_reveal_entries": true,
    "bold_folder_labels": true,
    "indent_size": 20,
    "indent_guides": {
      "show": "always",
    },
  },
  "outline_panel": {
    "button": true,
    "dock": "right",
    "folder_indicator": "icon",
    "file_icons": true,
    "git_status": true,
    "indent_size": 20,
  },

  "terminal": {
    "font_family": "Geist Mono",
    "font_fallbacks": ["JetBrains Mono", ".ZedMono"],
    "font_size": 15,
    "line_height": "comfortable",
    "blinking": "off",
    "working_directory": "current_project_directory",
  },

  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/.gradle",
    "**/target",
    "**/build",
    "**/out",
    "**/dist",
    "**/.next",
    "**/.cache",
    "**/coverage",
    "**/.idea",
    "**/.vscode",
    "**/.terraform",
  ],

  "languages": {
    "Skript": {
      "tab_size": 4,
      "hard_tabs": true,
      "format_on_save": "on",
      "formatter": "language_server",
      "semantic_tokens": "combined",
      "colorize_brackets": true,
      "document_symbols": "on",
      "document_folding_ranges": "on",
    },
    "Kotlin": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },
    "Java": {
      "tab_size": 4,
      "hard_tabs": false,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },
    "Gradle": {
      "tab_size": 4,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "Groovy": {
      "tab_size": 4,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.addMissingImports.ts": true,
        "source.fixAll.eslint": true,
      },
    },
    "TSX": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.addMissingImports.ts": true,
        "source.fixAll.eslint": true,
      },
    },
    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "HTML": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "CSS": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "JSON": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "JSONC": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "YAML": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },
    "XML": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },
    "Lua": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },
    "TOML": {
      "tab_size": 2,
      "format_on_save": "on",
    },
    "Properties": {
      "tab_size": 2,
      "format_on_save": "on",
    },
    "Shell Script": {
      "tab_size": 2,
      "format_on_save": "on",
    },
    "Dockerfile": {
      "tab_size": 2,
      "format_on_save": "on",
    },
    "Markdown": {
      "tab_size": 2,
      "soft_wrap": "editor_width",
      "format_on_save": "off",
    },
  },

  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx", "clsx", "tw", "cn"],
        "tailwindCSS": {
          "emmetCompletions": true,
        },
      },
    },
    "skript-lsp": {
      "binary": {
        "path": "E:/Dev Projects/ZedSkript/language-server/target/release/skript-lsp.exe",
      },
    },
    "discord_presence": {
      "initialization_options": {
        "idle": {
          "timeout": 3600,
          "action": "change_activity",
        },
      },
    },
  },
}
