{
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },

  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },

  "cli_default_open_behavior": "existing_window",

  "buffer_font_family": "Geist Mono",
  "buffer_font_fallbacks": ["JetBrains Mono", ".ZedMono"],
  "buffer_font_size": 16,
  "buffer_font_weight": 400,
  "buffer_font_features": {
    "calt": true,
    "liga": true,
  },
  "buffer_line_height": {
    "custom": 1.55,
  },

  "ui_font_family": "Geist",
  "ui_font_fallbacks": [".SystemUIFont", ".ZedSans"],
  "ui_font_size": 16,

  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "show_wrap_guides": false,

  "centered_layout": {
    "left_padding": 0.2,
    "right_padding": 0.2,
  },

  "cursor_blink": false,
  "scroll_beyond_last_line": "one_page",
  "relative_line_numbers": "disabled",
  "show_whitespaces": "selection",

  "autosave": "on_focus_change",
  "format_on_save": "modifications_if_available",
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "line_ending": "prefer_lf",

  "go_to_definition_scroll_strategy": "center",
  "code_lens": "on",

  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 2,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware",
  },

  "show_completions_on_input": true,
  "show_completion_documentation": true,

  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
  },

  "edit_predictions": {
    "provider": "zed",
    "mode": "eager",
  },

  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
    },
  },

  "agent": {
    "enabled": true,
    "button": true,
    "dock": "right",
    "default_width": 640,
  },

  "project_panel": {
    "button": true,
    "dock": "left",
    "git_status": true,
    "file_icons": true,
    "folder_icons": true,
    "auto_fold_dirs": true,
    "auto_reveal_entries": true,
    "indent_size": 20,
    "bold_folder_labels": true,
    "indent_guides": {
      "show": "always",
    },
  },

  "outline_panel": {
    "button": true,
    "dock": "right",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_size": 20,
  },

  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },

  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "right",
  },

  "terminal": {
    "font_family": "Geist Mono",
    "font_fallbacks": ["JetBrains Mono", ".ZedMono"],
    "font_size": 15,
    "line_height": "comfortable",
    "blinking": "off",
    "working_directory": "current_project_directory",
  },

  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "**/__pycache__",
    "**/target",
    "**/build",
    "**/dist",
    "**/.next",
    "**/.cache",
    "**/coverage",
    "**/.gradle",
    "**/out",
    "**/.idea",
  ],

  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },

    "TSX": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true,
      },
    },

    "JavaScript": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },

    "JSX": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },

    "HTML": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },

    "CSS": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },

    "SCSS": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },

    "Kotlin": {
      "tab_size": 4,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },

    "Java": {
      "tab_size": 4,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },

    "CSharp": {
      "tab_size": 4,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },

    "Lua": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },

    "YAML": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
      "document_symbols": "on",
    },

    "JSON": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },

    "JSONC": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },

    "TOML": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "Properties": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "XML": {
      "tab_size": 2,
      "format_on_save": "on",
      "colorize_brackets": true,
    },

    "Markdown": {
      "tab_size": 2,
      "soft_wrap": "editor_width",
      "format_on_save": "off",
    },

    "Shell Script": {
      "tab_size": 2,
      "format_on_save": "on",
    },

    "Dockerfile": {
      "tab_size": 2,
      "format_on_save": "on",
    },
  },

  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "tailwindCSS": {
          "emmetCompletions": true,
        },
        "classFunctions": ["cva", "cx", "clsx", "tw", "cn"],
      },
    },
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  "vim_mode": false,
}
