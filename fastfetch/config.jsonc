{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "%USERPROFILE%/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#5BCEFA",
      "2": "#F5A9B8",
      "3": "#FFFFFF",
    },
    "padding": {
      "top": 1,
      "right": 3,
    },
  },
  "display": {
    "separator": " ",
    "color": "#FFFFFF",
  },
  "modules": [
    "break",
    {
      "type": "title",
      "keyColor": "#5BCEFA",
      "color": {
        "user": "#F5A9B8",
        "at": "#FFFFFF",
        "host": "#5BCEFA",
      },
    },
    "break",
    {
      "type": "custom",
      "format": "╭─ System",
      "outputColor": "#F5A9B8",
    },
    {
      "type": "os",
      "key": "│  OS",
      "keyColor": "#5BCEFA",
    },
    {
      "type": "uptime",
      "key": "│ 󰔟 Uptime",
      "keyColor": "#F5A9B8",
      "format": "{formatted}",
    },
    {
      "type": "custom",
      "format": "├─ Hardware",
      "outputColor": "#F5A9B8",
    },
    {
      "type": "cpu",
      "key": "│  CPU",
      "keyColor": "#FFFFFF",
      "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}",
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU",
      "keyColor": "#5BCEFA",
      "format": "{name} • {dedicated-total} VRAM",
    },
    {
      "type": "board",
      "key": "│ 󰚗 Board",
      "keyColor": "#F5A9B8",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": "│  RAM",
      "keyColor": "#FFFFFF",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "custom",
      "format": "├─ Storage",
      "outputColor": "#F5A9B8",
    },
    {
      "type": "disk",
      "key": "│  C: Windows",
      "keyColor": "#5BCEFA",
      "folders": ["C:\\"],
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "disk",
      "key": "│  I: Fast SSD",
      "keyColor": "#F5A9B8",
      "folders": ["I:\\"],
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "disk",
      "key": "│  H: Games New",
      "keyColor": "#FFFFFF",
      "folders": ["H:\\"],
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "disk",
      "key": "│  D: Games HDD",
      "keyColor": "#F5A9B8",
      "folders": ["D:\\"],
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "disk",
      "key": "│  E: Extra",
      "keyColor": "#5BCEFA",
      "folders": ["E:\\"],
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "disk",
      "key": "│  F: Old SSD",
      "keyColor": "#F5A9B8",
      "folders": ["F:\\"],
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "disk",
      "key": "│  G: Backup HDD",
      "keyColor": "#FFFFFF",
      "folders": ["G:\\"],
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "custom",
      "format": "├─ Displays",
      "outputColor": "#F5A9B8",
    },
    {
      "type": "display",
      "key": "│ 󰍹",
      "keyColor": "#F5A9B8",
      "format": "{width}x{height} @ {refresh-rate} Hz",
      "preciseRefreshRate": false,
    },
    {
      "type": "custom",
      "format": "╰──────────────",
      "outputColor": "#F5A9B8",
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;91;206;250}●  {#38;2;245;169;184}●  {#38;2;255;255;255}●  {#38;2;245;169;184}●  {#38;2;91;206;250}●",
    },
  ],
}
